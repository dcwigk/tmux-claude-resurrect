[15.363825, "o", "s, hooks, MCP, agents, and more)\u001b[38;2;248;248;242m\u001b[K\u001b[11;74H  \u001b[38;5;246mUnset CLAUDE_CODE_SAFE_MODE to re-enable\u001b[38;2;248;248;242m\u001b[K\u001b[12;74H\u001b[K\u001b[38;5;239m\u001b[48;5;237m\n❯ \u001b[38;5;231mGive me two checks for secure session cookies. Keep it brief.\u001b[38;2;248;248;242m        \u001b[48;2;40;42;54m\u001b[14;74H\u001b[K\u001b[38;5;231m\n⏺\u001b[38;2;248;248;242m 1. \u001b[38;5;153m\u001b[1mSecure\u001b[38;2;248;248;242m and \u001b[38;5;153mHttpOnly\u001b[38;2;248;248;242m are both set.\u001b(B\u001b[m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m \u001b[38;5;153mSecure\u001b[38;2;248;248;242m means the browser sends  \u001b[16;74H     the cookie only over HTTPS. \u001b[38;5;153mHttpOnly\u001b[38;2;248;248;242m stops JavaScript from reading\u001b[17;74H     it through \u001b[38;5;153mdocument.cookie\u001b[38;2;248;248;242m, which limits the damage from XSS. You \u001b[18;74H     can check in DevTools → Application → Cookies, or run \u001b[38;5;153mcurl -sI\u001b[38;2;248;248;242m    \u001b[19;74H     \u001b[38;5;153mhttps://yoursite/login | grep -i set-cookie\u001b[38;2;248;248;242m.\u001b[K\u001b[20;74H  2. \u001b[38;5;153m\u001b[1mSameSite\u001b[38;2;248;248;242m is set "]
