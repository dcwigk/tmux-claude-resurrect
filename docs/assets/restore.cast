[25.093023, "o", "[38;5;153m\u001b[1mSecure\u001b[38;2;248;248;242m and \u001b[38;5;153mHttpOnly\u001b[38;2;248;248;242m are both set.\u001b(B\u001b[m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m \u001b[38;5;153mSecure\u001b[38;2;248;248;242m means the browser sends  \u001b[16;74H     the cookie only over HTTPS. \u001b[38;5;153mHttpOnly\u001b[38;2;248;248;242m stops JavaScript from reading\u001b[17;74H     it through \u001b[38;5;153mdocument.cookie\u001b[38;2;248;248;242m, which limits the damage from XSS. You \u001b[18;74H     can check in DevTools → Application → Cookies, or run \u001b[38;5;153mcurl -sI\u001b[38;2;248;248;242m    \u001b[19;74H     \u001b[38;5;153mhttps://yoursite/login | grep -i set-cookie\u001b[38;2;248;248;242m.\u001b[K\u001b[20;74H  2. \u001b[38;5;153m\u001b[1mSameSite\u001b[38;2;248;248;242m is set to \u001b[38;5;153mLax\u001b[38;2;248;248;242m or \u001b[38;5;153mStrict\u001b[38;2;248;248;242m.\u001b(B\u001b[m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m This helps block CSRF by keeping\u001b[21;74H     the browser from sending the cookie on cross-site requests. If    \u001b[22;74H     you really need \u001b[38;5;153mSameSite=None\u001b[38;2;248;248;242m, it must also have \u001b[38;5;153mSecure\u001b"]
[25.093031, "o", "[38;2;248;248;242m, and you  \u001b[23;74H     should add CSRF tokens.\u001b[K\u001b[24;74H\u001b[K\u001b[38;5;246m\n✻\u001b[38;2;248;248;242m \u001b[38;5;246mBrewed for 4s · done 4:34 PM\u001b[38;2;248;248;242m\u001b[K\u001b[26;74H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n \u001b[51X\u001b[38;5;246m\u001b[51C◉ xhigh · /effort\u001b[38;2;248;248;242m  \u001b[38;5;244m\u001b[39;74H───────────────────────────────────────────────────────────────────────\u001b[38;2;248;248;242m\u001b[40;74H❯ \u001b[K\u001b[38;5;244m\u001b[41;74H───────────────────────────────────────────────────────────────────────\u001b[38;2;248;248;242m\u001b[42;74H  \u001b[38;5;246m-- INSERT --\u001b[38;2;248;248;242m \u001b[38;5;211m⏵⏵ bypass permissions on\u001b[38;5;246m (shift+tab to cycle)\u001b[38;2;248;248;242m\u001b[K\u001b(B\u001b[m\u001b[40;76H"]
